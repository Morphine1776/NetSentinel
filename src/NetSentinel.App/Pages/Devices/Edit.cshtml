@page "/devices/edit/{id:int?}"
@model NetSentinel.Pages.Devices.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add device" : "Edit device";
}
<header class="top">
    <div>
        <p class="eyebrow"><a href="/">Devices</a></p>
        <h1>@(Model.IsNew ? "Add a device" : "Edit " + Model.Input.Name)</h1>
    </div>
</header>

@if (Model.Errors.Count > 0)
{
    <div class="banner bad" role="alert">
        @foreach (var error in Model.Errors)
        {
            <div>@error</div>
        }
    </div>
}
@if (Model.Warnings.Count > 0)
{
    <div class="banner warn" role="status">
        @foreach (var warning in Model.Warnings)
        {
            <div>@warning</div>
        }
    </div>
}

<form method="post" class="stack" id="device-form" autocomplete="off">
    <section class="panel form-grid">
        <label>
            Name
            <input asp-for="Input.Name" required maxlength="80" placeholder="Core switch" />
        </label>
        <label>
            Host or IP
            <input asp-for="Input.Host" required maxlength="255" placeholder="10.0.0.1" />
        </label>
        <label>
            Group
            <input asp-for="Input.GroupName" maxlength="80" placeholder="campus" />
        </label>
        <label>
            Location
            <input asp-for="Input.Location" maxlength="80" placeholder="MDF" />
        </label>
        <label>
            Tags
            <input asp-for="Input.Tags" maxlength="200" placeholder="core, edge" />
        </label>
        <label>
            Parent / uplink
            <select asp-for="Input.ParentDeviceId">
                <option value="">None</option>
                @foreach (var device in Model.OtherDevices.Where(device => device.Id != Model.Input.Id))
                {
                    <option value="@device.Id">@device.Name</option>
                }
            </select>
        </label>
        <label class="check">
            <input asp-for="Input.Enabled" />
            <span>Polling enabled</span>
        </label>
        <label>
            Context name
            <input asp-for="Input.V3Context" maxlength="64" />
            <span class="hint">Context stays on the device. It is not inherited.</span>
        </label>
    </section>

    <section class="panel" id="policy">
        <div class="panel-head">
            <h2>Policy</h2>
            <p class="hint">Unchecked fields inherit and stay inherited when you save, even if the box shows that value. Check Override only for a value you want to pin on this device. Secrets are write-only.</p>
        </div>
        <partial name="_PolicyFields" model="Model.Editor" />
        <div class="actions">
            @if (Model.IsNew)
            {
                <button class="btn" type="button" id="reset-all-inherited">Reset all to inherited</button>
            }
            else
            {
                <button class="btn" type="submit" form="reset-policy">Reset all to inherited</button>
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Custom OIDs</h2>
            <div class="actions">
                <button class="btn" type="button" id="walk-open" data-device-id="@(Model.Input.Id?.ToString() ?? "")">Walk</button>
                <button class="btn" type="button" id="add-oid">Add OID</button>
            </div>
        </div>
        <p class="hint">Polled with the device. Counter32 and Counter64 values also get a per-second rate for threshold rules. Walk discovers OIDs on this host so you can add them here, then save.</p>
        <div id="oid-list">
            @for (var i = 0; i < Model.Input.CustomOids.Count; i++)
            {
                <div class="oid-row">
                    <input type="hidden" data-field="Id" name="Input.CustomOids[@i].Id" value="@Model.Input.CustomOids[i].Id" />
                    <input data-field="Name" name="Input.CustomOids[@i].Name" value="@Model.Input.CustomOids[i].Name" placeholder="Name" maxlength="80" />
                    <input data-field="Oid" name="Input.CustomOids[@i].Oid" value="@Model.Input.CustomOids[i].Oid" placeholder="1.3.6.1.4.1…" class="mono" maxlength="200" />
                    <input data-field="Unit" name="Input.CustomOids[@i].Unit" value="@Model.Input.CustomOids[i].Unit" placeholder="Unit" maxlength="16" />
                    <span class="oid-kind" data-kind=""></span>
                    <button class="btn ghost remove-oid" type="button">Remove</button>
                </div>
            }
        </div>
    </section>

    <div class="actions">
        <button class="btn primary" type="submit">Save device</button>
        <a class="btn ghost" href="/">Cancel</a>
    </div>
</form>

@if (!Model.IsNew)
{
    <form id="reset-policy" method="post" asp-page-handler="ResetPolicy" asp-route-id="@Model.Input.Id" onsubmit="return confirm('Clear every policy override on this device?');"></form>
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Input.Id" class="danger-zone" onsubmit="return confirm('Remove this device and its stored samples?');">
        <div>
            <strong>Remove device</strong>
            <p>Deletes the device, its samples, and alerts scoped to it.</p>
        </div>
        <button class="btn danger" type="submit">Delete</button>
    </form>
}

<div id="walk-modal" class="modal-back" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="walk-title">
        <div class="panel-head">
            <h2 id="walk-title">Walk SNMP</h2>
        </div>
        <p class="hint">Uses the host on this form and the resolved SNMP settings: checked overrides, otherwise the location and global policy. Secrets stay on the server.</p>
        <div class="walk-controls">
            <label>Preset
                <select id="walk-preset">
                    <option value="custom" data-oid="" data-hint="" data-large="false">Custom OID</option>
                    @foreach (var preset in WalkPresets.All)
                    {
                        <option value="@preset.Id" data-oid="@preset.Oid" data-hint="@preset.Hint" data-large="@(preset.Large ? "true" : "false")">@preset.Label</option>
                    }
                </select>
            </label>
            <label>OID
                <input id="walk-oid" class="mono" maxlength="200" placeholder="1.3.6.1.2.1.1" autocomplete="off" />
            </label>
            <label>Max rows
                <input id="walk-max" type="number" min="1" max="5000" value="500" />
            </label>
        </div>
        <p class="hint" id="walk-hint"></p>
        <div class="banner warn" id="walk-large" hidden>Full MIB-2 is large. The walk stops at the row cap (500 by default, 5000 maximum) or after 20 seconds.</div>
        <div class="actions">
            <button class="btn primary" type="button" id="walk-go">Walk</button>
            <button class="btn ghost" type="button" id="walk-cancel">Cancel</button>
        </div>
        <div class="banner bad" id="walk-error" hidden></div>
        <div class="banner" id="walk-note" hidden></div>
        <label class="walk-filter">Filter
            <input id="walk-filter" placeholder="OID, label, type, or value" autocomplete="off" />
        </label>
        <div class="table-wrap walk-results">
            <table class="walk-table">
                <thead>
                    <tr>
                        <th>OID</th>
                        <th>Label</th>
                        <th>Type</th>
                        <th>Value</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="walk-rows"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/policy.js"></script>
    <script src="~/js/walk.js"></script>
}
