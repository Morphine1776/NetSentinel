@page "/devices/edit/{id:int?}"
@model NetSentinel.Pages.Devices.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add device" : "Edit device";
}
<header class="top">
    <div>
        <p class="eyebrow"><a href="/">Devices</a></p>
        <h1>@(Model.IsNew ? "Add a device" : "Edit " + Model.Input.Name)</h1>
    </div>
</header>

@if (Model.Errors.Count > 0)
{
    <div class="banner bad" role="alert">
        @foreach (var error in Model.Errors)
        {
            <div>@error</div>
        }
    </div>
}

<form method="post" class="stack" id="device-form">
    <section class="panel form-grid">
        <label>
            Name
            <input asp-for="Input.Name" required maxlength="80" placeholder="Core switch" />
        </label>
        <label>
            Host or IP
            <input asp-for="Input.Host" required maxlength="255" placeholder="10.0.0.1" />
        </label>
        <label>
            Group
            <input asp-for="Input.GroupName" maxlength="80" placeholder="campus" />
        </label>
        <label>
            Location
            <input asp-for="Input.Location" maxlength="80" placeholder="MDF" />
        </label>
        <label>
            Tags
            <input asp-for="Input.Tags" maxlength="200" placeholder="core, edge" />
        </label>
        <label>
            Parent / uplink
            <select asp-for="Input.ParentDeviceId">
                <option value="">None</option>
                @foreach (var device in Model.OtherDevices.Where(device => device.Id != Model.Input.Id))
                {
                    <option value="@device.Id">@device.Name</option>
                }
            </select>
        </label>
        <label class="check">
            <input asp-for="Input.Enabled" />
            <span>Polling enabled</span>
        </label>
        <label>
            Context name
            <input asp-for="Input.V3Context" maxlength="64" />
            <span class="hint">Context stays on the device. It is not inherited.</span>
        </label>
    </section>

    <section class="panel" id="policy">
        <div class="panel-head">
            <h2>Policy</h2>
            <p class="hint">Unchecked fields inherit. The most specific explicit value wins: device, then location, then global. Secrets are write-only.</p>
        </div>
        <partial name="_PolicyFields" model="Model.Editor" />
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Custom OIDs</h2>
            <button class="btn" type="button" id="add-oid">Add OID</button>
        </div>
        <p class="hint">Polled with the device. Counter32 and Counter64 values also get a per-second rate for threshold rules.</p>
        <div id="oid-list">
            @for (var i = 0; i < Model.Input.CustomOids.Count; i++)
            {
                <div class="oid-row">
                    <input type="hidden" data-field="Id" name="Input.CustomOids[@i].Id" value="@Model.Input.CustomOids[i].Id" />
                    <input data-field="Name" name="Input.CustomOids[@i].Name" value="@Model.Input.CustomOids[i].Name" placeholder="Name" maxlength="80" />
                    <input data-field="Oid" name="Input.CustomOids[@i].Oid" value="@Model.Input.CustomOids[i].Oid" placeholder="1.3.6.1.4.1…" class="mono" maxlength="200" />
                    <input data-field="Unit" name="Input.CustomOids[@i].Unit" value="@Model.Input.CustomOids[i].Unit" placeholder="Unit" maxlength="16" />
                    <button class="btn ghost remove-oid" type="button">Remove</button>
                </div>
            }
        </div>
    </section>

    <div class="actions">
        <button class="btn primary" type="submit">Save device</button>
        <a class="btn ghost" href="/">Cancel</a>
    </div>
</form>

@if (!Model.IsNew)
{
    <form method="post" asp-page-handler="Delete" asp-route-id="@Model.Input.Id" class="danger-zone" onsubmit="return confirm('Remove this device and its stored samples?');">
        <div>
            <strong>Remove device</strong>
            <p>Deletes the device, its samples, and alerts scoped to it.</p>
        </div>
        <button class="btn danger" type="submit">Delete</button>
    </form>
}

@section Scripts {
    <script src="~/js/policy.js"></script>
}
